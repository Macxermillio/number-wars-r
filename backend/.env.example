# Number Wars Environment Variables
# Copy this to .env and fill in your values

# Required for LLM opponent (Play vs AI mode)
# Get a key from https://openrouter.ai/keys
LLM_API_KEY=

# Optional: override the model and base URL
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Server port
PORT=3000

# CORS origin (frontend URL)
#   • Local dev: http://localhost:3000
#   • Client on Vercel + backend on Railway: set this to your Vercel URL,
#     e.g. https://number-wars-r.vercel.app
CORS_ORIGIN=http://localhost:3000

# Redis persistence (rooms survive restarts/deploys)
#   • Local: docker run -d -p 6379:6379 redis:7-alpine, then REDIS_URL=redis://localhost:6379
#   • Railway: add Redis DB to project, then reference ${{Redis.REDIS_URL}}
#     (private redis.railway.internal URL). Unset = memory-only mode.
REDIS_URL=